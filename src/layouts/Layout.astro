---
import { ClientRouter } from "astro:transitions";
import { PUBLIC_GOOGLE_SITE_VERIFICATION } from "astro:env/client";
import { SITE } from "@/config";
import "@/styles/global.css";

export interface Props {
  title?: string;
  subtitle?: string;
  author?: string;
  profile?: string;
  description?: string;
  keywords?: string;
  ogImage?: string;
  canonicalURL?: string;
  pubDatetime?: Date;
  modDatetime?: Date | null;
  scrollSmooth?: boolean;
  /** 条目自身标题（不含「| 站名」后缀），结构化数据的 headline 用它 */
  headline?: string;
  /** 条目标签，写进结构化数据的 keywords */
  tags?: string[];
  /** 页面是否不该被索引（搜索页、404 这类页面用） */
  noindex?: boolean;
}

const {
  title = `${SITE.title} | ${SITE.subtitle}`,
  author = SITE.author,
  profile = SITE.profile,
  description = SITE.desc,
  keywords = SITE.keywords,
  ogImage = SITE.ogImage ? `/${SITE.ogImage}` : "/og.png",
  canonicalURL = new URL(Astro.url.pathname, Astro.url),
  pubDatetime,
  modDatetime,
  scrollSmooth = false,
  headline = title,
  tags,
  noindex = false,
} = Astro.props;

const socialImageURL = new URL(ogImage, Astro.url);

/** 规范链接（canonical 可能是 URL 对象，也可能是 frontmatter 里的字符串） */
const canonicalHref = new URL(canonicalURL, Astro.url).href;

/** 站点自身的标识，作为分享图与结构化数据的 publisher */
const publisher = {
  "@type": "Organization",
  name: SITE.title,
  url: SITE.website,
  logo: {
    "@type": "ImageObject",
    url: new URL("/apple-touch-icon.png", SITE.website).href,
  },
};

/**
 * 结构化数据
 *
 * 条目页输出 BlogPosting（带发布/更新时间和正文词条），
 * 其余页面输出 WebSite —— 原先全站都硬套 BlogPosting，而列表页没有 pubDatetime，
 * 结果序列化出 `"datePublished":"undefined"` 这种非法值。
 */
const structuredData = pubDatetime
  ? {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline,
      description,
      image: [socialImageURL.href],
      datePublished: pubDatetime.toISOString(),
      dateModified: (modDatetime ?? pubDatetime).toISOString(),
      author: [
        {
          "@type": "Person",
          name: author,
          ...(profile && { url: profile }),
        },
      ],
      publisher,
      mainEntityOfPage: { "@type": "WebPage", "@id": canonicalHref },
      url: canonicalHref,
      inLanguage: SITE.lang,
      ...(tags?.length ? { keywords: tags.join(", ") } : {}),
    }
  : {
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: SITE.title,
      alternateName: SITE.subtitle,
      description: SITE.desc,
      url: new URL("/", SITE.website).href,
      inLanguage: SITE.lang,
      publisher,
      potentialAction: {
        "@type": "SearchAction",
        target: {
          "@type": "EntryPoint",
          urlTemplate: new URL(
            "/search/?q={search_term_string}",
            SITE.website
          ).href,
        },
        "query-input": "required name=search_term_string",
      },
    };
---

<!doctype html>
<html
  dir={SITE.dir}
  lang=`${SITE.lang ?? "en"}`
  class={`${scrollSmooth && "scroll-smooth"}`}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <!-- Favicon（由 scripts/build-favicons.mjs 生成，勿手改产物） -->
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="canonical" href={canonicalHref} />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {/* 地址栏配色跟随主题变量（浅 #fdfdfd / 深 #212737） */}
    <meta
      name="theme-color"
      content="#fdfdfd"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#212737"
      media="(prefers-color-scheme: dark)"
    />

    <!-- General Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content={author} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={pubDatetime ? "article" : "website"} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content={SITE.ogLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalHref} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={headline} />

    <!-- Article Published/Modified time -->
    {
      pubDatetime && (
        <meta
          property="article:published_time"
          content={pubDatetime.toISOString()}
        />
      )
    }
    {
      pubDatetime && (
        <meta
          property="article:modified_time"
          content={(modDatetime ?? pubDatetime).toISOString()}
        />
      )
    }

    <!-- Twitter（Twitter 读的是 name= 而不是 property=） -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalHref} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />
    <meta name="twitter:image:alt" content={headline} />

    <!-- Google JSON-LD Structured data -->
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData)}
    />

    <!-- Enable RSS feed auto-discovery  -->
    <!-- https://docs.astro.build/en/recipes/rss/#enabling-rss-feed-auto-discovery -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE.title}
      href={new URL("rss.xml", Astro.site)}
    />

    <meta name="theme-color" content="" />

    {
      // If PUBLIC_GOOGLE_SITE_VERIFICATION is set in the environment variable,
      // include google-site-verification tag in the heading
      // Learn more: https://support.google.com/webmasters/answer/9008080#meta_tag_verification&zippy=%2Chtml-tag
      PUBLIC_GOOGLE_SITE_VERIFICATION && (
        <meta
          name="google-site-verification"
          content={PUBLIC_GOOGLE_SITE_VERIFICATION}
        />
      )
    }

    <ClientRouter />

    <script is:inline src="/toggle-theme.js"></script>
  </head>
  <body>
    <slot />
    
    <!-- Umami Analytics - Only load in production -->
    {import.meta.env.PROD && <script is:inline src="/js/umami.js"></script>}
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
