---
import { render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Tag from "@/components/Tag.astro";
import DiaryDate from "@/components/DiaryDate.astro";
import EditPost from "@/components/EditPost.astro";
import ShareLinks from "@/components/ShareLinks.astro";
import Comments from "@/components/Comments.astro";
import BackButton from "@/components/BackButton.astro";
import BackToTopButton from "@/components/BackToTopButton.astro";
import { getDiaryPath } from "@/utils/getDiaryPath";
import { slugifyStr } from "@/utils/slugify";
import {
  countChars,
  formatChars,
  getReadingMinutes,
} from "@/utils/readingStats";
import {
  formatDate,
  formatMonth,
  getDiaryDate,
  getMonthAnchor,
  getYearAnchor,
} from "@/utils/date";
import IconChevronLeft from "@/assets/icons/IconChevronLeft.svg";
import IconChevronRight from "@/assets/icons/IconChevronRight.svg";
import type { DiaryEntry } from "@/types";
import { SITE } from "@/config";

export interface Props {
  post: DiaryEntry;
  posts: DiaryEntry[];
}

const { post, posts } = Astro.props;

const {
  title,
  author,
  description,
  ogImage: initOgImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  timezone,
  tags,
  hideEditPost,
  weather,
  location,
  mood,
} = post.data;

const { Content, headings } = await render(post);

/**
 * 正文目录
 *
 * 只取二级、三级标题。少于 3 节不渲染 —— 短篇一屏就看完了，加了只是噪声。
 * 标题的 id 由 rehype 管线生成，与这里的 slug 对应。
 */
const toc = headings.filter(heading => heading.depth === 2 || heading.depth === 3);

/** 篇幅与阅读时长：口径与概览统计一致 */
const chars = countChars(post.body ?? "");

let ogImageUrl: string | undefined;

// Determine OG image source
if (typeof initOgImage === "string") {
  ogImageUrl = initOgImage; // Remote OG image (absolute URL)
} else if (initOgImage?.src) {
  ogImageUrl = initOgImage.src; // Local asset
}

// Use dynamic OG image if enabled and no remote|local ogImage
// 注意 getDiaryPath 末尾已带斜杠，这里不能再补一个
if (!ogImageUrl && SITE.dynamicOgImage) {
  ogImageUrl = `${getDiaryPath(post.id, post.data)}index.png`;
}

// Resolve OG image URL (or fallback to SITE.ogImage / default `og.png`)
const ogImage = ogImageUrl
  ? new URL(ogImageUrl, Astro.url.origin).href
  : undefined;

const layoutProps = {
  title: `${title} | ${SITE.title}`,
  // 结构化数据要的是「条目自身的标题」，不带「| 站名」后缀
  headline: title,
  tags,
  keywords: tags.join(", "),
  author,
  description,
  pubDatetime,
  modDatetime,
  canonicalURL,
  ogImage,
  scrollSmooth: true,
};

const diaryDate = getDiaryDate(pubDatetime, timezone);

/** 当天的附加记录（写了才显示） */
const dayNotes = [
  weather && { label: "天气", value: weather },
  location && { label: "地点", value: location },
  mood && { label: "心情", value: mood },
].filter(Boolean) as { label: string; value: string }[];

/* ========== 时间上的相邻两则 ========== */

const allPosts = posts.map(entry => ({
  id: entry.id,
  title: entry.data.title,
  data: entry.data,
}));

const currentIndex = allPosts.findIndex(item => item.id === post.id);

// 列表按时间倒序：索引 -1 更近，索引 +1 更早
const newerEntry = currentIndex > 0 ? allPosts[currentIndex - 1] : null;
const olderEntry =
  currentIndex >= 0 && currentIndex + 1 < allPosts.length
    ? allPosts[currentIndex + 1]
    : null;
---

<Layout {...layoutProps}>
  <Header />
  <BackButton />
  <main
    id="main-content"
    tabindex="-1"
    class:list={[
      "mx-auto w-full max-w-app px-4 pb-12",
      { "mt-8": !SITE.showBackButton },
    ]}
    data-pagefind-body
  >
    <!-- 日期层级：日记 › 年 › 月 -->
    <nav aria-label="面包屑" class="mb-6 text-sm opacity-75">
      <ol class="flex flex-wrap items-center gap-1">
        <li>
          <a href="/diary/" class="hover:text-accent">日记</a>
        </li>
        <li aria-hidden="true">›</li>
        <li>
          <a
            href={`/archives/#${getYearAnchor(diaryDate.year())}`}
            class="hover:text-accent"
          >
            {diaryDate.format("YYYY")} 年
          </a>
        </li>
        <li aria-hidden="true">›</li>
        <li>
          <a
            href={`/archives/#${getMonthAnchor(diaryDate.year(), diaryDate.month() + 1)}`}
            class="hover:text-accent"
          >
            {formatMonth(diaryDate.month() + 1)}
          </a>
        </li>
      </ol>
    </nav>

    <div data-diary-entry>
      <DiaryDate {pubDatetime} {modDatetime} {timezone} size="lg" />
    </div>

    <h1
      transition:name={slugifyStr(title)}
      class="mt-6 inline-block text-2xl font-bold text-accent sm:text-3xl"
    >
      {title}
    </h1>

    <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2">
      {
        dayNotes.map(({ label, value }) => (
          <span class="rounded border border-border px-2 py-0.5 text-xs">
            <span class="opacity-70">{label}</span>
            <span class="ms-1">{value}</span>
          </span>
        ))
      }
      {/* 篇幅：外层不要再叠加 opacity，否则 0.8 × 0.7 = 0.56，浅色下低于 AA */}
      <span class="rounded border border-border px-2 py-0.5 text-xs">
        <span class="opacity-70">篇幅</span>
        <span class="ms-1">
          {formatChars(chars)} · 约 {getReadingMinutes(chars)} 分钟
        </span>
      </span>
      <EditPost {hideEditPost} {post} />
    </div>

    {
      /* 正文目录：节数多时默认收起，免得把正文推到屏幕外 */
      toc.length >= 3 && (
        <nav
          aria-label="本文目录"
          data-pagefind-ignore
          class="toc-inline mx-auto mt-8 max-w-app rounded border border-dashed border-border px-4 py-3"
        >
          <details class="group/toc" open={toc.length <= 8}>
            <summary class="flex cursor-pointer list-none items-baseline gap-2 [&::-webkit-details-marker]:hidden">
              <span class="text-sm font-medium">本文目录</span>
              <sup class="text-xs opacity-70">{toc.length} 节</sup>
              <IconChevronRight class="ms-auto size-4 self-center transition-transform group-open/toc:rotate-90" />
            </summary>
            <ol class="mt-3 space-y-1.5 text-sm">
              {toc.map(heading => (
                <li class:list={["flex gap-2", { "ms-4": heading.depth === 3 }]}>
                  <span aria-hidden="true" class="select-none opacity-70">
                    ·
                  </span>
                  <a
                    href={`#${heading.slug}`}
                    class="opacity-80 decoration-dashed underline-offset-4 hover:text-accent hover:underline hover:opacity-100"
                  >
                    {heading.text}
                  </a>
                </li>
              ))}
            </ol>
          </details>
        </nav>
      )
    }

    {
      /* 宽屏悬浮目录：仅在视口足够宽（见 .toc-floating 的媒体查询）时显示，
         落在正文左则留白里、fixed 定位，不挤压也不遮挡正文。窄屏不显示（用上方内联目录）。 */
      toc.length >= 3 && (
        <aside
          aria-label="本文目录"
          data-pagefind-ignore
          data-floating-toc
          class="toc-floating"
        >
          <p class="toc-head">
            <span>本文目录</span>
            <span class="toc-count">{toc.length} 节</span>
          </p>
          <ol class="toc-list">
            {toc.map(heading => (
              <li class:list={["toc-item", { "toc-h2": heading.depth === 2 }]}>
                {/* 标记放在 <a> 内部：hover / 点击 / 高亮的范围完全重合，
                    不会出现「鼠标还在文字外就变色」。默认 visibility:hidden 占位，
                    所以每一行的文字起点都对齐，切到当前节时也不会跳动。 */}
                <a
                  href={`#${heading.slug}`}
                  class:list={["toc-link", { "toc-sub": heading.depth === 3 }]}
                  title={heading.text}
                >
                  <IconChevronRight
                    class="toc-marker size-3 flex-none"
                    aria-hidden="true"
                  />
                  <span class="toc-text">{heading.text}</span>
                </a>
              </li>
            ))}
          </ol>
        </aside>
      )
    }

    <article
      id="article"
      class="app-prose mx-auto mt-8 max-w-app prose-pre:bg-(--shiki-light-bg) dark:prose-pre:bg-(--shiki-dark-bg)"
    >
      <Content />
    </article>

    <hr class="my-8 border-dashed" />

    {/* 标签之间要留横向间距：<Tag> 的 <li> 只有 inline-block + 纵向 margin，
        直接并排会贴成「#建站#评论系统」一坨。gap-x-3 与 DiaryCard 里的标签行一致。 */}
    <ul class="mt-4 mb-8 flex flex-wrap gap-x-3 sm:my-8">
      {tags.map(tag => <Tag tag={slugifyStr(tag)} tagName={tag} />)}
    </ul>

    <BackToTopButton />

    <ShareLinks />

    <hr class="my-6 border-dashed" />

    <Comments pageTitle={title} />

    <!-- 沿着时间线往前走／往回看 -->
    <div data-pagefind-ignore class="grid grid-cols-1 gap-6 sm:grid-cols-2">
      {
        olderEntry && (
          <a
            href={getDiaryPath(olderEntry.id, olderEntry.data)}
            class="flex w-full gap-1 hover:opacity-75"
          >
            <IconChevronLeft class="inline-block flex-none rtl:rotate-180" />
            <div>
              <span>前一则</span>
              <div class="text-sm text-accent/85">
                {formatDate(getDiaryDate(olderEntry.data.pubDatetime, olderEntry.data.timezone))}{" "}
                · {olderEntry.title}
              </div>
            </div>
          </a>
        )
      }
      {
        newerEntry && (
          <a
            href={getDiaryPath(newerEntry.id, newerEntry.data)}
            class="flex w-full justify-end gap-1 text-end hover:opacity-75 sm:col-start-2"
          >
            <div>
              <span>后一则</span>
              <div class="text-sm text-accent/85">
                {formatDate(getDiaryDate(newerEntry.data.pubDatetime, newerEntry.data.timezone))}{" "}
                · {newerEntry.title}
              </div>
            </div>
            <IconChevronRight class="inline-block flex-none rtl:rotate-180" />
          </a>
        )
      }
    </div>
  </main>
  <Footer />
</Layout>

<style>
  /* 宽屏悬浮目录：默认隐藏。仅在视口足够宽（≥1824px）时才显示 ——
     此时 max-w-app 已是 1280px（2xl），右侧留白足以容纳侧栏而不挤压/遮挡正文。
     形态取舍：侧栏落在留白里，不画虚线框/底色 —— 一条干净的竖排清单比「盒子」安静；
     正文 13.5/12.5px、每条最多两行（line-clamp），字号够读、长标题也不至于折三行；
     隐藏系统滚动条（留白里一条粗滚动条很突兀），靠「当前节自动滚进视野」提示还有内容。 */
  .toc-floating {
    display: none;
  }
  @media (min-width: 1824px) {
    .toc-floating {
      display: block;
      position: fixed;
      top: 6rem;
      /* 左边界锚在正文右缘外侧 1.5rem；宽度跟着剩余留白自适应，最多 18rem，
         所以从阈值到 4K 都不会压正文、也不会溢出视口右缘。 */
      left: calc(50% + 640px + 1.5rem);
      width: min(18rem, calc(50% - 680px));
      max-height: calc(100vh - 8rem);
      overflow-y: auto;
      overscroll-behavior: contain;
      scrollbar-width: none;
    }
    .toc-floating::-webkit-scrollbar {
      display: none;
    }
    /* 宽屏用悬浮目录，内联（会推低正文）的就不显示了 */
    .toc-inline {
      display: none;
    }
  }

  .toc-head {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
    font-size: 12px;
    letter-spacing: 0.08em;
    opacity: 0.6;
  }
  .toc-count {
    margin-inline-start: auto;
    font-variant-numeric: tabular-nums;
  }

  .toc-list {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }
  /* 每个二级标题之前空一点，把长清单切成「节」而不是 28 行连成一片灰墙 */
  .toc-item.toc-h2 {
    margin-top: 9px;
  }
  .toc-item.toc-h2:first-child {
    margin-top: 0;
  }

  .toc-link {
    display: flex;
    align-items: flex-start;
    gap: 4px;
    padding: 2px 4px 2px 0;
    font-size: 13.5px;
    line-height: 1.5;
    opacity: 0.85;
    text-decoration: none;
  }
  .toc-link:hover {
    color: var(--accent);
    opacity: 1;
  }
  /* 三级标题：更小、更淡、再缩进一格 —— 层级用字号与淡度表达，不再加「·」 */
  .toc-link.toc-sub {
    padding-left: 12px;
    font-size: 12.5px;
    opacity: 0.6;
  }
  /* 最多两行：带代码片段的超长标题折三行会把整条清单压垮 */
  .toc-text {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* 当前阅读到的节：箭头 + accent 文字。
     箭头用隐藏占位而非条件渲染，避免高亮切换时整行文字左右抖一下。 */
  .toc-marker {
    margin-top: 4px;
    visibility: hidden;
  }
  .toc-sub .toc-marker {
    margin-top: 3px;
  }
  .toc-floating a.toc-active {
    color: var(--accent);
    opacity: 1;
  }
  .toc-floating a.toc-active .toc-marker {
    visibility: visible;
  }
</style>

<script is:inline data-astro-rerun>
  /** 把「记录日期」换算成离今天多久：昨天 / 3 天前 / 距今天 267 天 */
  function updateDiaryDistance() {
    const today = new Date();
    const todayUTC = Date.UTC(
      today.getFullYear(),
      today.getMonth(),
      today.getDate()
    );

    document.querySelectorAll("[data-diary-distance]").forEach(node => {
      const iso = node.getAttribute("data-diary-date");
      if (!iso) return;

      const [year, month, day] = iso.split("-").map(Number);
      if (!year || !month || !day) return;

      const diff = Math.round(
        (todayUTC - Date.UTC(year, month - 1, day)) / 86400000
      );

      let text = "";
      if (diff === 0) text = "· 就是今天";
      else if (diff === 1) text = "· 昨天";
      else if (diff > 1) text = `· 距今天 ${diff} 天`;

      if (!text) return;
      node.textContent = text;
      node.classList.remove("hidden");
    });
  }
  updateDiaryDistance();
  document.addEventListener("astro:page-load", updateDiaryDistance);

  /** Create a progress indicator
   *  at the top */
  function createProgressBar() {
    // Create the main container div
    const progressContainer = document.createElement("div");
    progressContainer.className =
      "progress-container fixed top-0 z-10 h-1 w-full bg-background";

    // Create the progress bar div
    const progressBar = document.createElement("div");
    progressBar.className = "progress-bar h-1 w-0 bg-accent";
    progressBar.id = "myBar";

    // Append the progress bar to the progress container
    progressContainer.appendChild(progressBar);

    // Append the progress container to the document body or any other desired parent element
    document.body.appendChild(progressContainer);
  }
  createProgressBar();

  /** Update the progress bar
   *  when user scrolls */
  function updateScrollProgress() {
    document.addEventListener("scroll", () => {
      const winScroll =
        document.body.scrollTop || document.documentElement.scrollTop;
      const height =
        document.documentElement.scrollHeight -
        document.documentElement.clientHeight;
      const scrolled = (winScroll / height) * 100;
      if (document) {
        const myBar = document.getElementById("myBar");
        if (myBar) {
          myBar.style.width = scrolled + "%";
        }
      }
    });
  }
  updateScrollProgress();

  /** Attaches links to headings in the document,
   *  allowing sharing of sections easily */
  function addHeadingLinks() {
    const headings = Array.from(
      document.querySelectorAll("h2, h3, h4, h5, h6")
    );
    for (const heading of headings) {
      // w-fit/max-w-full：让标题盒紧贴文字（# 锚点链接在流内，其宽度也计入），
      // 于是 group-hover 的触发范围是「标题文字 + 锚点」，而不是整行标题的空白区域。
      heading.classList.add("group", "w-fit", "max-w-full");
      const link = document.createElement("a");
      link.className =
        "heading-link ms-2 no-underline opacity-75 md:opacity-0 md:group-hover:opacity-100 md:focus:opacity-100";
      link.href = "#" + heading.id;

      const span = document.createElement("span");
      span.ariaHidden = "true";
      span.innerText = "#";
      link.appendChild(span);
      heading.appendChild(link);
    }
  }
  addHeadingLinks();

  /** Attaches copy buttons to code blocks in the document,
   * allowing users to copy code easily. */
  function attachCopyButtons() {
    const copyButtonLabel = "复制";
    const codeBlocks = Array.from(document.querySelectorAll("pre"));

    for (const codeBlock of codeBlocks) {
      const wrapper = document.createElement("div");
      wrapper.style.position = "relative";

      // Check if --file-name-offset custom property exists
      const computedStyle = getComputedStyle(codeBlock);
      const hasFileNameOffset =
        computedStyle.getPropertyValue("--file-name-offset").trim() !== "";

      // Determine the top positioning class
      const topClass = hasFileNameOffset
        ? "top-(--file-name-offset)"
        : "-top-3";

      const copyButton = document.createElement("button");
      copyButton.className = `copy-code absolute end-3 ${topClass} rounded bg-muted border border-muted px-2 py-1 text-xs leading-4 text-foreground font-medium`;
      copyButton.innerHTML = copyButtonLabel;
      codeBlock.setAttribute("tabindex", "0");
      codeBlock.appendChild(copyButton);

      // wrap codebock with relative parent element
      codeBlock?.parentNode?.insertBefore(wrapper, codeBlock);
      wrapper.appendChild(codeBlock);

      copyButton.addEventListener("click", async () => {
        await copyCode(codeBlock, copyButton);
      });
    }

    async function copyCode(block, button) {
      const code = block.querySelector("code");
      const text = code?.innerText;

      await navigator.clipboard.writeText(text ?? "");

      // visual feedback that task is completed
      button.innerText = "已复制";

      setTimeout(() => {
        button.innerText = copyButtonLabel;
      }, 700);
    }
  }
  attachCopyButtons();

  /* Go to page start after page swap */
  document.addEventListener("astro:after-swap", () =>
    window.scrollTo({ left: 0, top: 0, behavior: "instant" })
  );

  /** 宽屏悬浮目录：高亮当前阅读到的节（scroll-spy）。
   *  侧栏在窄屏是 display:none，没有链接也无妨。
   *
   *  不能用 IntersectionObserver 的「最后一个进入回调的胜出」逻辑：
   *  当几个标题挨得很近时，跳转后它们会同时落在活动带里，回调顺序不保证是
   *  DOM 顺序，于是会高亮错项（常常是最后一个）。这里改成「按位置确定性地选
   *  —— 取顶部已越过活动线的最后一个标题」，并给点击加一个兜底，跳转瞬间就高亮对的那项。 */
  let tocSpyHandler = null;
  function initFloatingTocSpy() {
    if (tocSpyHandler) {
      window.removeEventListener("scroll", tocSpyHandler);
      tocSpyHandler = null;
    }
    const toc = document.querySelector("[data-floating-toc]");
    if (!toc) return;
    const links = Array.from(toc.querySelectorAll('a[href^="#"]'));
    const pairs = [];
    for (const link of links) {
      const id = decodeURIComponent(link.getAttribute("href").slice(1));
      const el = document.getElementById(id);
      if (el) pairs.push({ el, link });
    }
    if (!pairs.length) return;

    // 活动线：视口顶部往下一点（含 heading 的 scroll-margin-block:1rem ≈ 16px）。
    const ACTIVE_LINE = 24;

    let ticking = false;
    function computeActive() {
      ticking = false;
      // 滚到页面底部时，最后一节可能永远越不过活动线，强制选中最后一个。
      const atBottom =
        window.innerHeight + window.scrollY >=
        document.documentElement.scrollHeight - 2;
      let current = null;
      for (const { el } of pairs) {
        if (el.getBoundingClientRect().top <= ACTIVE_LINE) current = el;
        else break;
      }
      if (atBottom) current = pairs[pairs.length - 1].el;
      for (const { link } of pairs) link.classList.remove("toc-active");
      const hit = pairs.find((p) => p.el === current);
      if (hit) {
        hit.link.classList.add("toc-active");
        // 节数多时侧栏自身要滚：让当前节始终待在侧栏可视区内。
        // 只改侧栏的 scrollTop，不用 scrollIntoView —— 后者会连带滚页面。
        const box = toc.getBoundingClientRect();
        const row = hit.link.getBoundingClientRect();
        if (row.top < box.top) toc.scrollTop += row.top - box.top - 8;
        else if (row.bottom > box.bottom) toc.scrollTop += row.bottom - box.bottom + 8;
      }
    }

    function onScroll() {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(computeActive);
      }
    }
    tocSpyHandler = onScroll;
    window.addEventListener("scroll", onScroll, { passive: true });

    // 点击目录直接高亮对应项：跳转瞬间就定位对，不被滚动过程干扰。
    for (const { link } of pairs) {
      link.addEventListener("click", () => {
        for (const l of links) l.classList.remove("toc-active");
        link.classList.add("toc-active");
      });
    }

    // 初始 & view transitions 之后立即算一次
    computeActive();
  }
  initFloatingTocSpy();
  document.addEventListener("astro:page-load", initFloatingTocSpy);
</script>
