---
import { SITE } from "@/config";

interface Props {
  /** 用于 Artalk 的唯一页面标识，默认使用当前路径 */
  pageKey?: string;
  /** 评论区显示的页面标题，默认使用文章标题 */
  pageTitle?: string;
}

const { pageKey = Astro.url.pathname, pageTitle = SITE.title } = Astro.props;

const artalk = SITE.artalk;
---

{
  artalk.enabled && (
    <div id="comments" class="mt-12 mb-12" data-pagefind-ignore>
      <h2 class="mb-4 text-xl font-bold text-accent">评论</h2>
      <div id="artalk-comments"></div>
    </div>
  )
}

{
  artalk.enabled && (
    <script is:inline define:vars={{ artalk, pageKey, pageTitle }} data-astro-rerun>
      (function () {
        const ARTALK_JS = "https://cdn.jsdelivr.net/npm/artalk@2/dist/Artalk.js";
        const ARTALK_CSS = "https://cdn.jsdelivr.net/npm/artalk@2/dist/Artalk.css";
        let atk = null;

        function loadCSS(href) {
          if (document.querySelector('link[href="' + href + '"]')) return;
          const link = document.createElement("link");
          link.rel = "stylesheet";
          link.href = href;
          document.head.appendChild(link);
        }

        function isDark() {
          return document.documentElement.getAttribute("data-theme") === "dark";
        }

        function init() {
          if (!window.Artalk || !document.getElementById("artalk-comments")) return;
          if (atk) return;
          atk = window.Artalk.init({
            el: "#artalk-comments",
            server: artalk.server,
            site: artalk.site || location.hostname,
            pageKey: pageKey,
            pageTitle: pageTitle,
            darkMode: isDark(),
          });
          // 同步站点的明暗主题切换
          new MutationObserver(function () {
            atk.setDarkMode(isDark());
          }).observe(document.documentElement, {
            attributes: true,
            attributeFilter: ["data-theme"],
          });
        }

        function load() {
          if (!document.getElementById("artalk-comments")) return;
          loadCSS(ARTALK_CSS);
          if (window.Artalk) {
            init();
            return;
          }
          const s = document.createElement("script");
          s.src = ARTALK_JS;
          s.async = true;
          s.onload = init;
          document.head.appendChild(s);
        }

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", load);
        } else {
          load();
        }
      })();
    </script>
  )
}
