---
import { getCollection } from "astro:content";
import type { GetStaticPathsOptions } from "astro";
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import DiaryCard from "@/components/DiaryCard.astro";
import Pagination from "@/components/Pagination.astro";
import getUniqueTags from "@/utils/getUniqueTags";
import getPostsByTag from "@/utils/getPostsByTag";
import { SITE } from "@/config";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const entries = await getCollection("diary");
  const tags = getUniqueTags(entries);

  return tags.flatMap(({ tag, tagName }) => {
    const tagEntries = getPostsByTag(entries, tag);

    return paginate(tagEntries, {
      params: { tag },
      props: { tagName },
      pageSize: SITE.diaryPerPage,
    });
  });
}

const params = Astro.params;
const { tag } = params;
const { page, tagName } = Astro.props;
---

<Layout title={`标签: ${tagName} | ${SITE.title}`}>
  <Header />
  <Main
    pageTitle={[`标签:`, `${tagName}`]}
    titleTransition={tag}
    pageDesc={`关于「${tagName}」的那些日子`}
  >
    <ul>
      {page.data.map(entry => <DiaryCard {...entry} />)}
    </ul>
  </Main>

  <Pagination
    currentPage={page.currentPage}
    lastPage={page.lastPage}
    prevUrl={page.url.prev}
    nextUrl={page.url.next}
  />

  <Footer noMarginTop={page.lastPage > 1} />
</Layout>
