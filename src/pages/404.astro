---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import LinkButton from "@/components/LinkButton.astro";
import { SITE } from "@/config";
---

<Layout title={`页面未找到 | ${SITE.title}`} noindex>
  <Header />

  <main
    id="main-content"
    class="mx-auto flex max-w-app flex-1 items-center justify-center"
  >
    <div class="mb-14 flex flex-col items-center justify-center">
      <h2 class="text-9xl font-bold text-accent">404</h2>
      <span aria-hidden="true">¯\_(ツ)_/¯</span>
      <p class="mt-4 text-2xl sm:text-3xl">页面未找到</p>
      <p class="mt-3 max-w-md text-center text-sm opacity-75">
        这一页可能已经被删掉，或者换到了新的时间线上。可以试着从下面几处找找：
      </p>
      <nav aria-label="站点入口" class="mt-4 flex flex-wrap justify-center gap-x-5 gap-y-2 text-sm">
        <a href="/diary/" class="underline decoration-dashed underline-offset-4 hover:text-accent">时光轴</a>
        <a href="/photos/" class="underline decoration-dashed underline-offset-4 hover:text-accent">相册</a>
        <a href="/archives/" class="underline decoration-dashed underline-offset-4 hover:text-accent">年表</a>
        <a href="/tags/" class="underline decoration-dashed underline-offset-4 hover:text-accent">标签</a>
        <a href="/search/" class="underline decoration-dashed underline-offset-4 hover:text-accent">搜索</a>
      </nav>
      <LinkButton
        href="/"
        class="my-6 text-lg underline decoration-dashed underline-offset-8"
      >
        返回首页
      </LinkButton>
    </div>
  </main>

  <Footer />
</Layout>
